{
  "name": "jeroendn/ssd",
  "description": "Jeroen's Statistics/Status Dashboard",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.5",
    "ext-curl": "^8.0",
    "ext-simplexml": "*",
    "guzzlehttp/guzzle": "^7.4",
    "jeroendn/php-helpers": "^1.0",
    "jeroendn/php-js-console-logger": "^1.0",
    "jwilsson/spotify-web-api-php": "^7.2"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.52",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.5",
    "rector/rector": "^2.5"
  },
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "SSD\\Integrations\\Spotify\\": "integrations/Spotify/src",
      "SSD\\Integrations\\Steam\\": "integrations/Steam/src",
      "SSD\\Integrations\\Tweakers\\": "integrations/Tweakers/src",
      "SSD\\Integrations\\UptimeRobot\\": "integrations/UptimeRobot/src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SSD\\Test\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true
    },
    "sort-packages": true
  },
  "scripts": {
    "cs-check": "php-cs-fixer check",
    "cs-fix": "php-cs-fixer fix",
    "phpstan": "phpstan analyse",
    "phpstan-baseline": "phpstan analyse --generate-baseline --memory-limit=2G",
    "phpunit": "phpunit",
    "rector-check": "rector --dry-run",
    "rector-fix": "rector"
  }
}
